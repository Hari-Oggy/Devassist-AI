# ================================================
# DevAssist AI v3.0 — Environment Configuration
# ================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# At minimum you need:
#   1. One LLM API key (GEMINI_API_KEY is free to start)
#   2. GITHUB_TOKEN + GITHUB_REPO for GitHub integration
#   3. Redis running (docker-compose up -d redis)
# ================================================


# ─── LLM Provider Selection ──────────────────────────────────────────────────
# Options: openai, anthropic, gemini, local, nvidia, openrouter
LLM_PROVIDER=nvidia
LLM_MODEL=meta/llama-3.1-70b-instruct

# Pipeline mode: fast (single LLM call per file) or ensemble (3-stage distill/reason/validate)
# Fast mode is cheaper and ~3x faster. Ensemble finds more issues but costs more tokens.
REVIEW_MODE=ensemble

# LLM generation settings
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Task-specific temperature overrides
REVIEW_TEMPERATURE=0.0
DOC_TEMPERATURE=0.2

# Max LLM retries before falling back to next provider in the chain
LLM_MAX_RETRIES=3


# ─── LLM API Keys (at least one required) ────────────────────────────────────
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter (multi-model gateway) — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here


# ─── Local LLM (Ollama / vLLM / LM Studio) ───────────────────────────────────
# Set LLM_PROVIDER=local to use a local model
LOCAL_API_BASE=http://localhost:11434/v1
LOCAL_API_KEY=not-needed
LOCAL_MODEL=llama3.2


# ─── GitHub Integration ───────────────────────────────────────────────────────
# Create a Personal Access Token with 'repo' scope at:
# https://github.com/settings/tokens/new
GITHUB_TOKEN=your_github_personal_access_token_here

# The repository to monitor in owner/repo format
GITHUB_REPO=owner/repository-name

# HMAC secret for webhook signature verification
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Set the same value in your GitHub webhook settings
WEBHOOK_SECRET=your_webhook_secret_here

# Bot identity name — appears in comment markers
BOT_NAME=devassist-ai


# ─── GitHub App (Optional — for bot identity instead of PAT) ─────────────────
# Leave blank if using GITHUB_TOKEN above
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=


# ─── GitLab Integration (Optional) ───────────────────────────────────────────
# Personal Access Token with 'api' scope
GITLAB_TOKEN=your_gitlab_personal_access_token_here

# GitLab instance URL (use https://gitlab.com for GitLab.com)
GITLAB_API_URL=https://gitlab.com

# HMAC secret for GitLab webhook verification
GITLAB_WEBHOOK_SECRET=your_gitlab_webhook_secret_here


# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/devassist
#
# If DATABASE_URL is not set, the app automatically falls back to SQLite.
# SQLite is fine for local single-user use.
# DATABASE_URL=


# ─── Infrastructure (Redis) ───────────────────────────────────────────────────
# Redis is used as the Celery broker AND for SSE Pub/Sub event propagation.
# Start with: docker run -d --name devassist-redis -p 6379:6379 redis:alpine
REDIS_URL=redis://localhost:6379/0


# ─── RAG / Codebase Indexing ─────────────────────────────────────────────────
# Path to the local codebase to index for RAG context.
# Used by scripts/setup_index.py to pre-build the FAISS index.
# Leave as ./local_repo and symlink/copy your repo there, or point to the repo directly.
CODEBASE_PATH=./local_repo
FAISS_INDEX_PATH=./data/faiss_index


# ─── Review Behavior ──────────────────────────────────────────────────────────
# Maximum diff characters to send to the LLM (truncates very large diffs)
MAX_DIFF_SIZE=15000

# Minimum seconds between reviews of the same PR (prevents review spam on rapid pushes)
REVIEW_DEBOUNCE_SECONDS=60

# Skip draft PRs (don't review until marked ready)
SKIP_DRAFT_PRS=true

# If set, only review PRs that have this label (leave empty to review all PRs)
REQUIRE_LABEL=

# Whether to use GitHub webhooks or fall back to polling
POLLING_ENABLED=false
POLLING_INTERVAL=30


# ─── Cache ────────────────────────────────────────────────────────────────────
# Cache identical LLM prompts in Redis to save API costs on repeated reviews
CACHE_ENABLED=false
CACHE_TTL=3600


# ─── Timeouts ─────────────────────────────────────────────────────────────────
REVIEW_TIMEOUT=300
DOC_TIMEOUT=120


# ─── CORS / API Security ──────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from the browser.
# This must match wherever your Next.js frontend is running.
CORS_ORIGINS=http://localhost:3000

# Optional: protect API endpoints with an API key header (X-API-Key)
# Leave empty to disable API key auth (fine for local self-hosted use)
API_KEY=


# ─── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
